# Settings for the Professor Outreach Assistant.
# Copy this file to ".env" (1_setup_windows.bat does it for you) and edit the copy.
# Never put real passwords in this file, and never upload .env to GitHub (it is Git-ignored).

# Email safety. drafts_only = the tool never sends email (recommended).
# send_enabled allows "send --method gmail-api", but only after you approve each email and type a confirmation.
EMAIL_MODE=drafts_only
# Always true; the tool ignores attempts to switch human approval off.
REQUIRE_HUMAN_APPROVAL=true
# Most emails that can be sent per day (keep it small; quality beats volume).
DAILY_SEND_LIMIT=30
# Days to wait before one polite follow-up. MAX_FOLLOW_UPS is 0 or 1 (default 1; never more).
FOLLOW_UP_DAYS=10
MAX_FOLLOW_UPS=1
# Only professors with at least this fit score (0-10) get drafts.
MIN_FIT_FOR_DRAFT=4

DEFAULT_INTAKE_PRIORITY=Spring 2027
SECONDARY_INTAKE=Fall 2027

# Your email, sent to websites in the polite "User-Agent" so site owners can contact you (optional).
CONTACT_EMAIL=
# Seconds between requests to the same website (at least 1; default 2).
REQUEST_DELAY_SECONDS=2

# OPTIONAL integrations (leave blank if not used). See docs/CREDENTIALS_AND_LIMITS.md
# Free key from https://openalex.org/settings/api (required by OpenAlex since Feb 2026)
OPENALEX_API_KEY=
# Optional NCBI key (not required by this version)
NCBI_API_KEY=
# CV attached to Gmail drafts, e.g. private_profile/Sana_Sajid_CV.pdf
CV_ATTACHMENT=
# Gmail API OAuth files (default: private_profile/credentials.json and private_profile/token.json)
GMAIL_OAUTH_CLIENT_FILE=
GMAIL_TOKEN_FILE=
